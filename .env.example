# Environment variables for WA Marketing BD — apps/web
# Copy this file to apps/web/.env.local and fill in real values from SECRETS.md.
# NEVER put real values in this file — it is committed to git.

# Supabase project URL (from Supabase dashboard > Project Settings > API)
VITE_SUPABASE_URL=

# Supabase anonymous / public key (safe for browser — enforces RLS)
VITE_SUPABASE_ANON_KEY=

# Cloudinary cloud name (from Cloudinary dashboard)
VITE_CLOUDINARY_CLOUD_NAME=

# Cloudinary unsigned upload preset name (created in Cloudinary dashboard)
VITE_CLOUDINARY_UPLOAD_PRESET=

# Production site URL — used for OG tags, sitemap, canonical URLs
VITE_SITE_URL=
